# Base URL of the Transmission daemon. The app adds /transmission/rpc.
# Do not end it with a slash.
TRANSMISSION_RPC_URL=http://localhost:9091

# Transmission RPC credentials.
TRANSMISSION_RPC_USERNAME=
TRANSMISSION_RPC_PASSWORD=

# Optional. Set both to require basic auth on this app.
APP_USERNAME=
APP_PASSWORD=

# SonarQube Cloud user token for the SonarQube MCP server (see .mcp.json).
# Create one under My Account > Security in SonarQube Cloud.
SONARQUBE_TOKEN=
